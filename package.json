{
  "name": "rn-smart-charts-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for rn-smart-charts: a React Native Skia chart library with TradingView-style pan and zoom.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lib:build": "pnpm --filter rn-smart-charts build",
    "lib:test": "pnpm --filter rn-smart-charts test",
    "lib:typecheck": "pnpm --filter rn-smart-charts typecheck",
    "example:android": "pnpm --filter @rn-smart-charts/example android",
    "example:start": "pnpm --filter @rn-smart-charts/example start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.5.4"
  }
}
